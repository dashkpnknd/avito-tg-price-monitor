# Do not commit the real values. Store them on the server in /opt/avito-price-monitor/.env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
MONITOR_CONFIG_PATH=/app/config.json
STATE_PATH=/app/data/state.json
CHECK_INTERVAL_MINUTES=60
MISMATCH_GRACE_HOURS=5
# One project-level digest at most during this period. New problems are
# collected for the next digest instead of sending a message per product.
NOTIFICATION_REPEAT_HOURS=24
MAX_AVITO_PAGES=100
DRY_RUN=false
