# Do not commit the real values. Store them on the server in /opt/avito-price-monitor/.env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Telegram numeric IDs allowed to add projects in a private chat, comma-separated.
TELEGRAM_ADMIN_USER_IDS=
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
MONITOR_CONFIG_PATH=/app/config.json
STATE_PATH=/app/data/state.json
CHECK_INTERVAL_MINUTES=60
MISMATCH_GRACE_HOURS=5
# A persistent problem receives a fresh full report after this period.
# The bot replaces the previous report where Telegram permits deletion.
NOTIFICATION_REPEAT_HOURS=5
MAX_AVITO_PAGES=100
DRY_RUN=false
